<?xml version="1.0"?>
<robot name="quaro" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Various constant definitions -->
  <xacro:include filename='$(find quaro_description)/urdf/common/constants.xacro'/>
  <!-- Material Colors -->
  <xacro:include filename="$(find quaro_description)/urdf/common/colors.xacro"/>
  <!-- Leg macro -->
  <xacro:include filename="$(find quaro_description)/urdf/leg/leg.0.0.xacro"/>
  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://quaro_description/meshes/body.stl" scale="${scale} ${scale} ${scale}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- Chain 1 -->
  <xacro:leg n="1" parent="base_link" xyz="0.0470 0.0920 0.0257" rpy="${pi/2} 0 ${pi/4}"/>
  <!-- Chain 2 -->
  <xacro:leg n="2" parent="base_link" xyz="-0.0470 0.0920 0.0257" rpy="${pi/2} 0 ${3*pi/4}"/>
  <!-- Chain 3 -->
  <xacro:leg n="3" parent="base_link" xyz="0.0470 -0.0920 0.0257" rpy="${pi/2} 0 -${pi/4}"/>
  <!-- Chain 4 -->
  <xacro:leg n="4" parent="base_link" xyz="-0.0470 -0.0920 0.0257" rpy="${pi/2} 0 -${3*pi/4}"/>

</robot>
